rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Tiến độ học: mỗi người chỉ đọc/ghi bản lưu của chính mình
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }
    // Bảng xếp hạng: ai cũng xem được, mỗi người chỉ ghi thành tích của mình
    match /board/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'words', 'xp', 'band', 'streak', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.words is int && request.resource.data.words >= 0 && request.resource.data.words <= 20000
        && request.resource.data.xp is int && request.resource.data.streak is int;
    }
    // Mọi thứ khác: cấm
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
